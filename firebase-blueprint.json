{
  "entities": {
    "BusinessListing": {
      "title": "BusinessListing",
      "description": "A verified local business, hospital, ambulance, or professional service in Jhalakathi district.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nameBn": { "type": "string", "minLength": 3, "maxLength": 150 },
        "nameEn": { "type": "string", "maxLength": 150 },
        "categoryId": { "type": "string", "maxLength": 64 },
        "subCategoryBn": { "type": "string", "maxLength": 80 },
        "upazila": { "type": "string", "enum": ["sadar", "nalchity", "rajapur", "kathalia", "all"] },
        "addressBn": { "type": "string", "maxLength": 300 },
        "phone": { "type": "string", "minLength": 3, "maxLength": 20 },
        "altPhone": { "type": "string", "maxLength": 20 },
        "whatsapp": { "type": "string", "maxLength": 20 },
        "descriptionBn": { "type": "string", "maxLength": 2000 },
        "servicesBn": { "type": "array" },
        "image": { "type": "string", "format": "uri" },
        "openingHoursBn": { "type": "string", "maxLength": 100 },
        "verified": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "status": { "type": "string", "enum": ["published", "draft", "archived"] },
        "views": { "type": "number" },
        "rating": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "nameBn", "categoryId", "upazila", "addressBn", "phone", "status", "verified"]
    },
    "PostItem": {
      "title": "PostItem",
      "description": "District administrative notices, local job circulars, news, and tourism guides.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "titleBn": { "type": "string", "minLength": 5, "maxLength": 250 },
        "titleEn": { "type": "string", "maxLength": 250 },
        "slug": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "enum": ["news", "notice", "job", "tourism", "health_tip", "education"] },
        "excerptBn": { "type": "string", "maxLength": 500 },
        "contentBn": { "type": "string" },
        "image": { "type": "string", "format": "uri" },
        "authorBn": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["published", "draft", "scheduled", "archived"] },
        "scheduledDate": { "type": "string", "format": "date-time" },
        "tags": { "type": "array" },
        "views": { "type": "number" },
        "isFeatured": { "type": "boolean" },
        "isBreaking": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "titleBn", "slug", "category", "excerptBn", "contentBn", "status"]
    },
    "EmergencyContact": {
      "title": "EmergencyContact",
      "description": "Critical 24/7 emergency service and helpline contact numbers.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nameBn": { "type": "string", "maxLength": 100 },
        "designationBn": { "type": "string", "maxLength": 100 },
        "department": { "type": "string", "enum": ["police", "fire_service", "hospital", "ambulance", "admin", "helpline", "electricity"] },
        "upazila": { "type": "string", "enum": ["sadar", "nalchity", "rajapur", "kathalia", "all"] },
        "phone": { "type": "string", "minLength": 3, "maxLength": 20 },
        "altPhone": { "type": "string", "maxLength": 20 },
        "addressBn": { "type": "string", "maxLength": 250 },
        "isNationalHotline": { "type": "boolean" },
        "priority": { "type": "number" }
      },
      "required": ["id", "nameBn", "department", "phone", "upazila"]
    },
    "Advertisement": {
      "title": "Advertisement",
      "description": "Commercial banners and promotional campaigns with placement options.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "titleBn": { "type": "string", "maxLength": 120 },
        "clientName": { "type": "string", "maxLength": 100 },
        "clientPhone": { "type": "string", "maxLength": 20 },
        "bannerUrl": { "type": "string", "format": "uri" },
        "targetUrl": { "type": "string" },
        "placement": { "type": "string", "enum": ["home_top", "between_posts", "sidebar", "footer", "bottom_sticky"] },
        "isActive": { "type": "boolean" },
        "displayOrder": { "type": "number" },
        "deviceTarget": { "type": "string", "enum": ["all", "mobile", "desktop"] },
        "impressions": { "type": "number" },
        "clicks": { "type": "number" }
      },
      "required": ["id", "titleBn", "placement", "isActive"]
    },
    "ServiceRequest": {
      "title": "ServiceRequest",
      "description": "Citizen submission for adding local shop/service to directory.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "applicantName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "businessNameBn": { "type": "string", "minLength": 3, "maxLength": 150 },
        "category": { "type": "string", "maxLength": 64 },
        "upazila": { "type": "string", "enum": ["sadar", "nalchity", "rajapur", "kathalia", "all"] },
        "phone": { "type": "string", "minLength": 3, "maxLength": 20 },
        "addressBn": { "type": "string", "maxLength": 250 },
        "detailsBn": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "submittedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "applicantName", "businessNameBn", "phone", "status"]
    }
  },
  "firestore": {
    "/businesses/{businessId}": {
      "schema": { "$ref": "BusinessListing" },
      "description": "Stores verified and published businesses and services."
    },
    "/posts/{postId}": {
      "schema": { "$ref": "PostItem" },
      "description": "Stores news articles, circulars, and notices."
    },
    "/emergency_contacts/{contactId}": {
      "schema": { "$ref": "EmergencyContact" },
      "description": "Public emergency contacts directory."
    },
    "/advertisements/{adId}": {
      "schema": { "$ref": "Advertisement" },
      "description": "Monetized advertisement banners and placements."
    },
    "/service_requests/{reqId}": {
      "schema": { "$ref": "ServiceRequest" },
      "description": "Citizen submissions awaiting admin approval."
    }
  }
}
