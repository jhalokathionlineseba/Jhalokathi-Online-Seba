rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny - Zero Trust Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jhalokathionlineseba.jos@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation helper for Business Listings
    function isValidBusiness(data) {
      return data.nameBn is string && data.nameBn.size() >= 3 && data.nameBn.size() <= 150 &&
             data.categoryId is string &&
             data.phone is string && data.phone.size() >= 3 && data.phone.size() <= 20 &&
             data.addressBn is string && data.addressBn.size() <= 300 &&
             data.status in ['published', 'draft', 'archived'] &&
             data.verified is bool;
    }

    // Validation helper for Posts & Notices
    function isValidPost(data) {
      return data.titleBn is string && data.titleBn.size() >= 5 && data.titleBn.size() <= 250 &&
             data.slug is string && data.slug.size() <= 200 &&
             data.category in ['news', 'notice', 'job', 'tourism', 'health_tip', 'education'] &&
             data.excerptBn is string && data.excerptBn.size() <= 500 &&
             data.contentBn is string &&
             data.status in ['published', 'draft', 'scheduled', 'archived'] &&
             data.isFeatured is bool;
    }

    // 1. Business Listings
    match /businesses/{businessId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create: if isAdmin() && isValidId(businessId) && isValidBusiness(incoming());
      allow update: if isAdmin() && isValidId(businessId) && isValidBusiness(incoming());
      allow delete: if isAdmin() && isValidId(businessId);
    }

    // 2. Posts, Notices and Job Circulars
    match /posts/{postId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create: if isAdmin() && isValidId(postId) && isValidPost(incoming());
      allow update: if isAdmin() && isValidId(postId) && isValidPost(incoming());
      allow delete: if isAdmin() && isValidId(postId);
    }

    // 3. Emergency Contacts Directory
    match /emergency_contacts/{contactId} {
      allow read: if true; // Public safety access
      allow create, update, delete: if isAdmin() && isValidId(contactId);
    }

    // 4. Advertisements
    match /advertisements/{adId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(adId);
    }

    // 5. Site Settings and Appearance
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Citizen Service Listing Requests
    match /service_requests/{reqId} {
      allow create: if isValidId(reqId) &&
                       incoming().applicantName is string && incoming().applicantName.size() >= 2 &&
                       incoming().businessNameBn is string && incoming().businessNameBn.size() >= 3 &&
                       incoming().phone is string && incoming().phone.size() >= 3 &&
                       incoming().status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    // 7. Admin Activity Logs
    match /activity_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // 8. Admin Role Roster
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // Provisioned exclusively via trusted server or initial bootstrap
    }
  }
}
